# This file specifies snyk vulnerabilities to be ignored.
# If this file contains only comments, then no vulnerabilities are ignored.
# Referenced in the workflow's synk-test.
#
# There is one entry per vulnerability the current scan reports, and no others.
# When a scan stops reporting a vulnerability its entry and its docs/vulns file
# are removed; git holds the earlier assessments. Entries expire after 30 days so
# each assessment is re-reviewed rather than ignored forever.


ignore:
  # no CVE | gRPC-Go internal/transport | Score 8.8 | Not exploitable: vulnerable v1.80.0 is in containerd/ctr, which serve gRPC over local Unix sockets; runner configures no xDS RBAC policies; --net=none
  SNYK-GOLANG-GOOGLEGOLANGORGGRPCINTERNALTRANSPORT-18172578:
    - '*':
        reason: Not exploitable in runner context; see docs/vulns/readme.txt
        expires: 2026-09-21T00:00:00.000Z
        created: 2026-07-23T00:00:00.000Z

  # no CVE | aws-sdk-go-v2 CloudWatch Logs EventStream | Score 8.2 | Not exploitable: requires MITM of TLS CloudWatch endpoint; DoS only
  SNYK-GOLANG-GITHUBCOMAWSAWSSDKGOV2SERVICECLOUDWATCHLOGS-16316406:
    - '*':
        reason: Not exploitable in runner context; see docs/vulns/readme.txt
        expires: 2026-09-21T00:00:00.000Z
        created: 2026-05-08T10:53:10.201Z

  # CVE-2026-41178 | OTel baggage | Score 6.9 | Not exploitable: only containerd and ctr still vendor otel v1.43.0; containerd serves its API on a local Unix socket and ctr is a CLI, so no attacker-supplied header reaches the baggage parser
  SNYK-GOLANG-GOOPENTELEMETRYIOOTELBAGGAGE-17054906:
    - '*':
        reason: Not exploitable in runner context; see docs/vulns/readme.txt
        expires: 2026-09-21T00:00:00.000Z
        created: 2026-06-01T00:00:00.000Z

  # CVE-2026-41178 | OTel propagation | Score 6.9 | Not exploitable: only containerd and ctr still vendor otel v1.43.0; containerd serves its API on a local Unix socket and ctr is a CLI, so no attacker-supplied header reaches the baggage parser
  SNYK-GOLANG-GOOPENTELEMETRYIOOTELPROPAGATION-17054905:
    - '*':
        reason: Not exploitable in runner context; see docs/vulns/readme.txt
        expires: 2026-09-21T00:00:00.000Z
